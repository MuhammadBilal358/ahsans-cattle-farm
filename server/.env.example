# Copy this file to .env and fill in your own values.  (cp .env.example .env)

# MongoDB connection string (MongoDB Atlas or local)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/ahsans-cattle-farm?retryWrites=true&w=majority

# Any long random string — used to sign admin login tokens
JWT_SECRET=replace-with-a-long-random-string

# Port the API server runs on
PORT=5000

# The admin account created the first time you run "npm run seed"
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-password

# Cloudinary (free image hosting) — needed for photo uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional: the website address(es) allowed to call this API, comma-separated.
# Leave empty during local development.
# CLIENT_URL=https://your-site.netlify.app
